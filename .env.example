# 测试环境配置（复制此文件为 .env 并填入真实值）
# 被测系统地址（登录页完整URL）
BASE_URL=https://your-test-site.com/login

# 双进程账号 A
TEST_USERNAME_A=your_username_a
TEST_PASSWORD_A=your_password_a
STORE_NAME_A=

# 双进程账号 B（必须与账号 A 不同）
TEST_USERNAME_B=your_username_b
TEST_PASSWORD_B=your_password_b
STORE_NAME_B=

# 传统单进程兼容配置：留空时自动使用账号 A
TEST_USERNAME=
TEST_PASSWORD=
STORE_NAME=

# SERIAL 用例默认使用账号 A；需要时可改为 B
TEST_SERIAL_ACCOUNT_SLOT=A

# 视觉模型（影像阅览页 UI 验证）
VISION_API_KEY=sk-your-key
VISION_BASE_URL=https://your-gateway/api
VISION_MODEL=qwen-vl-max
VISION_TIMEOUT=60
VISION_THINKING_BUDGET=16384
VISION_ENABLE_THINKING=
# 留空使用内置“只报告可见内容”的纪律 Prompt
VISION_SYSTEM_PROMPT=
# 相同截图+Prompt 在单个进程内复用结果
VISION_CACHE_ENABLED=true
VISION_CACHE_MAX_ITEMS=256
# 默认只在 Allure 中保存结构化结果和截图哈希，避免持久化客户影像
VISION_ATTACH_SCREENSHOT=false
VISION_MIN_SCREENSHOT_BYTES=512
# 标准截图目录；默认按 <目录>/<用例ID>/reference.png 自动查找，只读且不会自动覆盖
VISION_BASELINE_DIR=test_assets/vision_baselines
# 标准图必须带 reference.meta.json，并通过哈希、尺寸、截图区域和人工批准校验
VISION_REQUIRE_BASELINE_METADATA=true
# 默认保留视觉失败，不允许通用失败复跑机制把模型不一致改判通过
VISION_RERUN_FAILURES=false
