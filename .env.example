# 测试环境配置（复制此文件为 .env 并填入真实值）
# 被测系统地址（登录页完整URL）
BASE_URL=https://your-test-site.com/login

# 双进程账号 A
TEST_USERNAME_A=your_username_a
TEST_PASSWORD_A=your_password_a
STORE_NAME_A=

# 双进程账号 B（必须与账号 A 不同）
TEST_USERNAME_B=your_username_b
TEST_PASSWORD_B=your_password_b
STORE_NAME_B=

# 传统单进程兼容配置：留空时自动使用账号 A
TEST_USERNAME=
TEST_PASSWORD=
STORE_NAME=

# SERIAL 用例默认使用账号 A；需要时可改为 B
TEST_SERIAL_ACCOUNT_SLOT=A
